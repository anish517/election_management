# ==============================================================================
# EMS (Election Management System) — Environment Variables Template
# Copy this file to 'backend/.env' and customize your values:
# cp .env.example backend/.env
# ==============================================================================

SECRET_KEY=django-insecure-dev-secret-key-change-this-in-production-abc123xyz
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.110.108,*

# Database Configuration:
# SQLite (Default out-of-the-box — zero setup required):
DATABASE_URL=sqlite:///./ems_dev.db
# PostgreSQL (Optional for high-concurrency production):
# DATABASE_URL=postgres://ems_user:ems_password@localhost:5432/ems_db

# Cache & Celery:
USE_REDIS=False
REDIS_URL=redis://localhost:6379/0

# CORS & Frontend URL:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.110.108:3000
FRONTEND_URL=http://localhost:3000

# JWT Auth:
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# Sparrow SMS (Nepal SMS OTP):
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=SparrowSMS

# SMTP Email Gateway:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Firebase Push Notifications (Optional):
FCM_SERVER_KEY=

# Initial Superuser Seed:
SUPER_ADMIN_EMAIL=admin@emsplatform.com
SUPER_ADMIN_PASSWORD=Admin@12345
