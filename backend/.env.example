# ==============================================================================
# EMS (Election Management System) — Backend Environment Variables Template
# Copy this file to '.env' in this directory and customize your values:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Django Core Security & Host Configuration
# ------------------------------------------------------------------------------
# Generate a strong key for production (e.g. via python -c 'import secrets; print(secrets.token_urlsafe(50))')
SECRET_KEY=django-insecure-dev-secret-key-change-this-in-production-abc123xyz
DEBUG=True

# Comma-separated list of allowed hostnames/IPs
# For local dev / LAN mobile testing: localhost,127.0.0.1,192.168.x.x
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.110.108,*

# ------------------------------------------------------------------------------
# 2. Database Configuration (SQLite Default / PostgreSQL Optional)
# ------------------------------------------------------------------------------
# Option A: SQLite (Default — uses local single-file database, ZERO installation needed)
DATABASE_URL=sqlite:///./ems_dev.db

# Option B: PostgreSQL (Optional — for high-concurrency production deployments)
# DATABASE_URL=postgres://ems_user:ems_password@localhost:5432/ems_db

# ------------------------------------------------------------------------------
# 3. Cache & Background Task Queue (Redis / Local Memory)
# ------------------------------------------------------------------------------
# If USE_REDIS is False, Django uses built-in Python memory (LocMemCache).
USE_REDIS=False
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. CORS & Frontend Integration
# ------------------------------------------------------------------------------
# Origins allowed to make API requests (Flutter Web origin)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.110.108:3000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 5. JWT Authentication Lifetimes
# ------------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# ------------------------------------------------------------------------------
# 6. Sparrow SMS Gateway (Nepal Production OTP & Magic Links)
# ------------------------------------------------------------------------------
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=SparrowSMS

# ------------------------------------------------------------------------------
# 7. SMTP Email Gateway (Gmail, SendGrid, Amazon SES)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com



# ------------------------------------------------------------------------------
# 9. Super Admin Initial Seed Credentials (Optional for management commands)
# ------------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@emsplatform.com
SUPER_ADMIN_PASSWORD=Admin@12345
